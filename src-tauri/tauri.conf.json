{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nazgul",
  "version": "0.2.1",
  "identifier": "com.nazgul.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nazgul",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "signCommand": "cmd /c sign-hook.cmd %1"
    },
    "publisher": "Wyatt Rossell",
    "copyright": "Copyright (C) 2026 Wyatt Rossell",
    "shortDescription": "Nazgul OSINT workbench",
    "longDescription": "Nazgul is a desktop open-source-intelligence workbench that searches public data sources. Public data only; no credential access or authentication bypass."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGMTU2RUY4NTA2NUFGNApSV1QwV2dhRjcxYnhBM2FHckRrdjZabyt2TERQUVowanBoTjRHMXVWdVp1YlIwTlRjM0VSTzZVYgo=",
      "endpoints": [
        "https://github.com/wyattrossell/Nazgul/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
